{  "$schema": "https://json-schema.org/draft/2020-12/schema",  "$id": "urn:cow-agent:model-result:1.0",  "title": "CowAgent analysis result v1.0",  "type": "object",  "additionalProperties": false,  "required": ["schema_version", "video_id", "analysis_id", "source_kind", "model_version", "video_sha256", "duration_s", "sample_interval_s", "behavior_catalog", "tracks", "detections", "warnings"],  "properties": {    "schema_version": {"const": "1.0"},    "video_id": {"type": "string", "minLength": 1},    "analysis_id": {"type": "string", "minLength": 1},    "source_kind": {"enum": ["mock", "model"]},    "model_version": {"type": "string", "minLength": 1},    "video_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},    "duration_s": {"type": "number", "exclusiveMinimum": 0},    "sample_interval_s": {"type": "number", "exclusiveMinimum": 0},    "behavior_catalog": {      "type": "array", "minItems": 1,      "items": {        "type": "object", "additionalProperties": false,        "required": ["code", "label", "definition"],        "properties": {          "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "not": {"const": "unknown"}},          "label": {"type": "string", "minLength": 1},          "definition": {"type": "string", "minLength": 1},          "source_class_id": {"type": ["integer", "null"], "minimum": 0}        }      }    },    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},    "detections": {"type": "array", "items": {"$ref": "#/$defs/detection"}},    "warnings": {"type": "array", "items": {"type": "string"}}  },  "$defs": {    "interval": {      "type": "object", "additionalProperties": false,      "required": ["start_s", "end_s"],      "properties": {"start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "exclusiveMinimum": 0}}    },    "segment": {      "type": "object", "additionalProperties": false,      "required": ["segment_id", "start_s", "end_s", "behavior"],      "properties": {        "segment_id": {"type": "string", "minLength": 1},        "start_s": {"type": "number", "minimum": 0},        "end_s": {"type": "number", "exclusiveMinimum": 0},        "behavior": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}      }    },    "track": {      "type": "object", "additionalProperties": false,      "required": ["track_id", "observed_intervals", "segments"],      "properties": {        "track_id": {"type": "string", "minLength": 1},        "observed_intervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}},        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}      }    },    "detection": {      "type": "object", "additionalProperties": false,      "required": ["time_s", "track_id", "behavior", "bbox_xywh_norm", "confidence"],      "properties": {        "time_s": {"type": "number", "minimum": 0},        "track_id": {"type": "string", "minLength": 1},        "behavior": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},        "bbox_xywh_norm": {          "type": "array", "minItems": 4, "maxItems": 4,          "items": {"type": "number", "minimum": 0, "maximum": 1}        },        "confidence": {"type": "number", "minimum": 0, "maximum": 1}      }    }  }}