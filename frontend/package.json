  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "@playwright/test": "^1.51.0",
    "openapi-typescript": "^7.6.1",
    "@types/node": "^22.0.0"
  }
